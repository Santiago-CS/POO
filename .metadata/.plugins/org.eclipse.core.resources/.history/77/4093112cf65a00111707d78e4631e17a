import javax.swing.JOptionPane;

public class Ejer2 {

	public static void main(String[] args) {
		long iteraciones = 0;
        String entrada;
        
        // 1. TU CICLO DE VALIDACIÓN
        while(true) {
            entrada = JOptionPane.showInputDialog(
                    "Cálculo de PI por Serie de Leibniz\n" +
                    "Introduce el número de iteraciones o 'exit' para salir):");
            
            // Si presionan Cancelar o la X
            if(entrada == null) {
                System.out.println("Introduce Un Numero");
                continue;
            }
            
            // Si escriben exit
            if(entrada.equals("exit")) {
                break;
            }
            
            // Intentamos convertir la entrada a número
            try {
                iteraciones = Long.parseLong(entrada.trim()); //Long para soportar millones
                
                if(iteraciones <= 0) {
                    JOptionPane.showMessageDialog(null, "El número debe ser mayor a 0.");
                    continue;
                }
               
                break; 
                
            } catch(NumberFormatException e) {
                JOptionPane.showMessageDialog(null, 
                        "Error: Debes introducir un número entero sin letras.", 
                        "Dato Inválido", 
                        JOptionPane.ERROR_MESSAGE);
            }
        }	        
        
        double piAprox = 0.0;
	        
	        for (int i = 0; i < iteraciones; i++) {
	            double termino = 4.0 / (2.0 * i + 1);
	            if (i % 2 == 0) 
	            {
	                piAprox += termino;
	            } else 
	            {
	                piAprox -= termino;
	            }
	        }
	        
	        System.out.println("Valor aproximado de PI: " + piAprox);
	    }
	}

